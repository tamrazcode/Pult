{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pult",
  "version": "0.1.2",
  "identifier": "app.pult.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Pult",
        "width": 1267,
        "height": 788,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "focus": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/tamrazcode/Pult/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5OTlENkQyRjcxMEVCMTYKUldRVzZ4RDMwdGFaQ1VGUVFPV2RjM0ROdGVvUnZHT3R2d1d5aHZNRmNZVWs1ZFltbU5Vdisrc24K"
    }
  }
}
