{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pult",
  "version": "0.1.0",
  "identifier": "app.pult.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Pult",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "x": 1960,
        "y": 60,
        "focus": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/OWNER/pult/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyMTk3MzVEOTZDOTY1QTgKUldTb1pjbVdYWE1ac251OG9nclh5T2hLRHUxeVcraXRMdzVMbWlJWG9CY1ptcHVEbGhURGVPYWgK"
    }
  }
}
